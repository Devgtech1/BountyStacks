# PostgreSQL connection string from your database provider.
# URL-encode special characters in the database password.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Solana Devnet settings. This is the BountyStacks escrow program deployed on devnet.
NEXT_PUBLIC_SOLANA_CLUSTER="devnet"
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.devnet.solana.com"
NEXT_PUBLIC_SOLANA_PROGRAM_ID="5n4acPr6EXFp1USWDxAtk3Fqiex9tsLa7yTK8wjHz4yg"

# Generate locally; never commit the real values.
# SESSION_SECRET: openssl rand -hex 32
SESSION_SECRET="REPLACE_WITH_A_PRIVATE_RANDOM_SECRET"
# SUBMISSION_ENCRYPTION_KEY: openssl rand -base64 32
SUBMISSION_ENCRYPTION_KEY="REPLACE_WITH_A_PRIVATE_BASE64_32_BYTE_KEY"

# Comma-separated administrator wallet public keys (server-only; never NEXT_PUBLIC_).
ADMIN_WALLET_ADDRESSES=""

# Local development URL; set to the deployed HTTPS origin in production.
APP_URL="http://localhost:3000"
